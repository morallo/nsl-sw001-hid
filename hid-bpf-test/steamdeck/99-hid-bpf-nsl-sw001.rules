# N-SL SW001 HID-BPF (Steam Deck): self-contained loader under /home.
#
# No /usr writes, no pacman, no steamos-readonly unlock.  The loader binary,
# its bundled libs and the BPF object live in /home/.steamos-nsl-sw001-bpf/
# (never touched by A/B updates); this rule is re-asserted from the seed by
# the ensure service if it is ever pruned.
ACTION!="add", GOTO="nsl_sw001_end"
SUBSYSTEM!="hid", GOTO="nsl_sw001_end"
ENV{MODALIAS}!="hid:b0005g*v0000057Ep00002009", GOTO="nsl_sw001_end"
RUN{program}+="/home/.steamos-nsl-sw001-bpf/sw001-bpf-attach $sys$devpath /home/.steamos-nsl-sw001-bpf/nsl-sw001.bpf.o"
LABEL="nsl_sw001_end"